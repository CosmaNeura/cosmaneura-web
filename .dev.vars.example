# Copy to `.dev.vars` for local testing with `wrangler pages dev` (never commit real keys).
# In production these are set in Cloudflare Pages → Settings → Environment variables.

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public assistant presentation configuration. This is not authorization or
# entitlement; the configured Sovereign must be the separately deployed,
# capability-limited public mount and must allow this website origin via CORS.
# Leave unset to keep the panel off. Set only to the public deployment's bare
# HTTPS origin (no path, query, credentials, or fragment).
# PUBLIC_SOVEREIGN_ORIGIN=https://public-sovereign.example.com
